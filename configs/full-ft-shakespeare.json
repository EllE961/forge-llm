{
  "train": {
    "run_name": "shakespeare-full-ft",
    "init_from": "checkpoints/tinystories-30m/model.safetensors",
    "train_bin": "data/shakespeare/all.bin",
    "val_bin": null,
    "val_frac": 0.9,
    "batch_size": 16,
    "grad_accum": 1,
    "seq_len": 256,
    "max_steps": 400,
    "warmup_steps": 30,
    "lr": 0.0003,
    "min_lr_ratio": 0.1,
    "weight_decay": 0.1,
    "grad_clip": 1.0,
    "eval_interval": 25,
    "eval_batches": 20,
    "log_interval": 10,
    "ckpt_interval": 800,
    "sample_prompts": [
      "ROMEO:",
      "First Citizen:\nWe"
    ],
    "sample_tokens": 80,
    "dtype": "bf16",
    "save_last": false
  }
}
